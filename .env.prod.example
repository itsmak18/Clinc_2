# ── Production environment template ───────────────────────────────────────────
# All values here MUST be injected via your secrets manager (AWS Secrets Manager,
# GCP Secret Manager, Doppler, etc.) — never store real values in this file.
#
# When deploying via docker-compose, create a .env at the repo root with these
# values before running: docker compose up -d
# OR pass them through your CI/CD pipeline as masked environment variables.

# ── Database ───────────────────────────────────────────────────────────────────
# Use RDS Postgres (AWS) or Cloud SQL (GCP) — must be HIPAA-eligible and have a
# signed BAA before any PHI is written.
DATABASE_URL="postgresql://PROD_USER:PROD_PASSWORD@your-rds-endpoint:5432/clinic_hub"

# ── API Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="production"

# ── Secrets handled OUTSIDE this file (file-mounted via Docker secrets) ───────
# The api and redis containers load these from /run/secrets/* at startup.
# Do NOT add any of these to `environment:` — they would be visible in `docker inspect`.
# Create files instead, then chmod 600:
#   ./secrets/postgres_password        — POSTGRES_USER bootstrap password (migrate only)
#                                        openssl rand -base64 48 | tr -d '\n'
#   ./secrets/app_db_password          — medicore_app role password (api + worker)
#                                        openssl rand -base64 48 | tr -d '\n'
#                                        The migrate container sets this on the medicore_app
#                                        role after db:migrate completes (ADR-008, F-01 fix).
#   ./secrets/redis_password           — openssl rand -base64 48 | tr -d '\n'
#   ./secrets/session_secret           — HMAC key for device fingerprinting (Phase 2)
#                                        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   ./secrets/field_encryption_key     — AES-256-GCM; LOSING THIS = TOTAL PHI LOSS.
#                                        same Node generator. Escrow before first prod boot.
#   ./secrets/metrics_token            — openssl rand -hex 32
#   ./secrets/jwt_private_key          — Ed25519 PKCS8 PEM; signs all JWTs. Rotate quarterly.
#   ./secrets/jwt_public_key           — Ed25519 SPKI PEM; advertised at /.well-known/jwks.json.
#                                        Both keys must be a matched pair — generate atomically:
#                                        node -e "const c=require('crypto');const kp=c.generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});require('fs').writeFileSync('./secrets/jwt_private_key',kp.privateKey);require('fs').writeFileSync('./secrets/jwt_public_key',kp.publicKey)"
# Rotation + compromise response: see docs/SECURITY.md §"JWT key rotation" and §"Secret rotation".
# The legacy JWT_SECRET env var was removed — JWT signing now uses EdDSA via jwt_private_key.
# SESSION_SECRET is now the HMAC key for device-fingerprint only (lib/device-fingerprint.ts).
# REDIS_URL is assembled from redis_password inside the api entrypoint — never put it in environment:.

# ── JWT key metadata (not secret — controls which kid is the current writer) ───
# Set when you promote a new key pair after rotation. Default "1".
# JWT_KID="1"
# Previous key for overlap window during rotation (optional — see docs/SECURITY.md):
# JWT_PREV_KID="0"

# ── Session Store ─────────────────────────────────────────────────────────────
# Redis is REQUIRED in production for rate-limit counters, SSE pub/sub,
# and session revocation. Use ElastiCache (AWS) or Memorystore (GCP).
SESSION_STORE="redis"
# When using docker-compose.prod.yml: REDIS_URL is assembled in the entrypoint
# from ./secrets/redis_password — do NOT set it here.
# When pointing at an external managed Redis (ElastiCache, Memorystore):
# REDIS_URL="redis://:PASSWORD@your-endpoint:6379"

# ── Backup encryption (scripts/backup-verify.mjs) ─────────────────────────────
# REQUIRED in prod — script rejects unencrypted backups when NODE_ENV=production.
# Key ID or email of the GPG recipient. See docs/BACKUP_KEY_MANAGEMENT.md for
# generation, distribution, escrow, and rotation procedure.
BACKUP_GPG_RECIPIENT="backups@medicore.internal"

# Local + offsite path policy.
BACKUP_STORAGE_PATH="/var/lib/medicore/backups"
BACKUP_RETENTION_DAYS=30

# Offsite rsync-over-SSH destination — REQUIRED, compose fail-closes if unset.
BACKUP_RSYNC_TARGET="deploy@offsite.example.com:/srv/backups/medicore/"

# Shell command run after the local backup verifies. {FILE} is substituted with
# the local file path. Use rclone / aws-cli / scp — whichever can reach your
# named offsite destination. Examples:
#   "rclone copy {FILE} backblaze-b2:medicore-backups/"
#   "aws s3 cp {FILE} s3://medicore-backups/"
OFFSITE_UPLOAD_COMMAND="rclone copy {FILE} REPLACE_WITH_REMOTE:medicore-backups/"

# Set only on the offline restore workstation when running quarterly drills.
# Never set on a production host.
# RESTORE_DATABASE_URL=""

# ── Container image pinning (REQUIRED for prod compose) ───────────────────────
# Tag-only references silently update when a registry re-tags `:N-alpine`.
# Every base image must be pinned by digest. Re-pin on every base-image upgrade
# and record the new digest in CHANGELOG.md. Populate each digest via:
#   docker pull <repo>:<tag> && docker inspect --format='{{index .RepoDigests 0}}' <repo>:<tag>
# docker-compose.prod.yml fail-closes if any of these is unset.
POSTGRES_IMAGE="postgres:16-alpine@sha256:REPLACE_WITH_DIGEST"
REDIS_IMAGE="redis:7-alpine@sha256:REPLACE_WITH_DIGEST"
CADDY_IMAGE="caddy:2-alpine@sha256:REPLACE_WITH_DIGEST"
PGBOUNCER_IMAGE="edoburu/pgbouncer:1.23.1@sha256:REPLACE_WITH_DIGEST"

# ── Edge proxy (Caddy) ────────────────────────────────────────────────────────
# Domain Caddy obtains TLS certs for via Let's Encrypt HTTP-01.
# DNS A/AAAA records for this name MUST point at this host before first boot.
CADDY_DOMAIN="clinic.example.com"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set the exact origin(s) your frontend is served from.
# Example: ALLOWED_ORIGINS="https://app.example.com"
ALLOWED_ORIGINS="https://YOUR_FRONTEND_DOMAIN"

# ── Observability ─────────────────────────────────────────────────────────────
# METRICS_TOKEN was moved to ./secrets/metrics_token (file-mounted). See the
# "Secrets handled OUTSIDE this file" block at the top of this file.

# ── Database Pool ─────────────────────────────────────────────────────────────
DB_POOL_MAX=40
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECT_TIMEOUT=5000

# ── Docker Compose postgres service ───────────────────────────────────────────
# Only used when running docker-compose.yml directly (not for managed RDS).
POSTGRES_DB=clinic_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
