{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "dev:build": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env ./dist/index.mjs",
    "start:worker": "node --enable-source-maps --env-file-if-exists=../../.env ./dist/worker.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration-db": "vitest run --config vitest.config.integration.ts",
    "lint": "eslint src/routes",
    "validate:errors": "tsx src/scripts/validate-errors.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^5.2.3",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "pino": "^9",
    "pino-http": "^10",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "eslint": "^9.0.0",
    "pg": "^8.22.0",
    "pino-pretty": "^13",
    "supertest": "^7.1.0",
    "testcontainers": "^12.0.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.2.6"
  }
}
