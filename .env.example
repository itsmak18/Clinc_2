# Environment variables required for the MediCore application

# ── Database ───────────────────────────────────────────────────────────────────
# The primary PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_hub"

# (Optional) The database URL used by scripts/backup-verify.mjs for restore testing.
RESTORE_DATABASE_URL="postgresql://user:password@localhost:5432/clinic_hub_restore_test"

# ── API Server Configuration ───────────────────────────────────────────────────
# The port the API server will listen on (default: 5000).
PORT=5000

# The secret key used to sign JWTs. Must be a long, random string.
JWT_SECRET="generate_a_secure_random_string_here"

# The environment mode: "development" or "production".
NODE_ENV="development"

# ── CORS Configuration ─────────────────────────────────────────────────────────
# Comma-separated list of Replit domains allowed to access the API.
REPLIT_DOMAINS="your-replit-domain.repl.co,another-domain.repl.co"

# ── Database Connection Pool (Tuning) ──────────────────────────────────────────
# The maximum number of connections in the pool.
DB_POOL_MAX=10

# How long a connection can be idle before being closed (in milliseconds).
DB_POOL_IDLE_TIMEOUT=30000

# How long to wait for a new connection before timing out (in milliseconds).
DB_POOL_CONNECT_TIMEOUT=5000

# ── Session Store ─────────────────────────────────────────────────────────────
# Controls which backend is used for rate-limiting, SSE pub/sub, and token
# revocation. Defaults to "memory" when NODE_ENV != "production".
#
#   memory  — in-process, no external dependency. For local dev only.
#             Rate-limit counters and session revocations reset on restart.
#   redis   — Redis-backed, cluster-safe. Required for production.
#             Must also set REDIS_URL below.
#
SESSION_STORE="memory"

# Redis connection string (required only when SESSION_STORE=redis).
REDIS_URL="redis://localhost:6379"

# ── Backup Configuration ───────────────────────────────────────────────────────
# The local directory or mounted path to store database backups.
BACKUP_STORAGE_PATH="./backups"

# How many days to retain backups before deleting them.
BACKUP_RETENTION_DAYS=30
