# ── Development environment template ──────────────────────────────────────────
# Copy this to .env and fill in real values. See .env.prod.example for
# production/staging values.
# NEVER commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/clinic_hub"

# (Optional) Used by scripts/backup-verify.mjs for restore-testing.
RESTORE_DATABASE_URL="postgresql://user:password@localhost:5432/clinic_hub_restore_test"

# ── API Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# SESSION_SECRET is the HMAC key for device fingerprinting (Phase 2 device-trust).
# It is NO LONGER used to sign JWTs — signing now uses EdDSA (JWT_PRIVATE_KEY below).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="generate_a_secure_random_string_here"

# ── JWT EdDSA key pair (replaces HS256 SESSION_SECRET signing) ────────────────
# Production: mount as Docker secrets (./secrets/jwt_private_key + jwt_public_key).
# Development: set below. Generate a matched pair with one command:
#   node -e "const c=require('crypto');const kp=c.generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('JWT_PRIVATE_KEY='+JSON.stringify(kp.privateKey));console.log('JWT_PUBLIC_KEY='+JSON.stringify(kp.publicKey))"
# If omitted in development, an ephemeral key pair is generated at startup (sessions
# invalidated on restart — acceptable in dev, never acceptable in prod).
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Kid (key ID) for the current signing key. Must match the kid in JWT headers.
# Change to "2", "3" etc. when rotating keys. Default "1".
JWT_KID="1"

# Previous public key + kid — set during rotation overlap window only (optional).
# See SECURITY.md §"JWT key rotation" for the rotation procedure.
JWT_PREV_PUBLIC_KEY=""
JWT_PREV_KID=""

# ── Session Store ─────────────────────────────────────────────────────────────
# "memory" — in-process (dev). "redis" — required for production.
SESSION_STORE="memory"

# Required when SESSION_STORE=redis
REDIS_URL="redis://localhost:6379"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Replit-specific: comma-separated list of Replit domains allowed for CORS.
REPLIT_DOMAINS=""

# Non-Replit prod: comma-separated list of additional allowed origins.
# Example: ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"
ALLOWED_ORIGINS=""

# ── Observability ─────────────────────────────────────────────────────────────
# Bearer token to protect GET /metrics. Leave empty to disable in dev.
# Set in production: METRICS_TOKEN="$(openssl rand -hex 32)"
METRICS_TOKEN=""

# ── Database Pool Tuning ───────────────────────────────────────────────────────
DB_POOL_MAX=40
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECT_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# ── Backup ─────────────────────────────────────────────────────────────────────
BACKUP_STORAGE_PATH="./backups"
BACKUP_RETENTION_DAYS=30

# ── Security ───────────────────────────────────────────────────────────────────
# Emergency lever — set to "disabled" to bypass JWT fingerprint checks.
# See RUNBOOK.md §5. Never set in normal operation.
FINGERPRINT_BINDING=""
