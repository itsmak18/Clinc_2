# ── Caddy reverse proxy for MediCore production ──────────────────────────────
# Replaces the nginx :80-only TLS gap (C5). Caddy obtains + auto-renews
# certs via Let's Encrypt HTTP-01 (or DNS-01 if you add a DNS plugin).
#
# Edge responsibilities:
#   - TLS termination (auto)
#   - HTTP→HTTPS redirect (auto)
#   - HSTS preload (A13)
#   - Block /metrics at the edge (defense in depth — api also gates it)
#   - Edge rate limit (C6 follow-up — Caddy needs `caddy-ratelimit` plugin)
#
# {$CADDY_DOMAIN} comes from the compose `environment:` block.

{$CADDY_DOMAIN} {
    # Modern TLS + automatic HSTS preload (max-age 2y, includeSubDomains, preload)
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Frame-Options           "DENY"
        X-Content-Type-Options    "nosniff"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "camera=(), microphone=(), geolocation=()"
        # Cross-origin isolation: prevents this app from being embedded by, or
        # leaking resources to, third-party origins. Defense in depth on top of
        # X-Frame-Options DENY above.
        Cross-Origin-Opener-Policy    "same-origin"
        Cross-Origin-Resource-Policy  "same-origin"
        Cross-Origin-Embedder-Policy  "require-corp"
        # Hide server fingerprint
        -Server
    }

    # ── Phase 4.3 edge WAF: block common scan paths before they reach the api ──
    # These are paths that no legitimate MediCore client ever requests. Blocking
    # at the edge keeps probe noise out of pino-http logs and reduces audit-trail
    # cardinality. Returns 403 with no body, so a scanner sees a uniform response
    # to any of these and gets minimal information.
    @scan_paths path \
        /.env* /.git* /.svn* /.hg* /.aws/* \
        /wp-admin* /wp-login* /wordpress* /xmlrpc.php \
        /phpinfo* /phpmyadmin* /pma* \
        /vendor/* /node_modules/* \
        /actuator* /actuator/health \
        /admin.php /administrator/* /admin/login* \
        /server-status /server-info \
        /backup.* /db.* /database.* /dump.sql \
        /.well-known/security.txt
    respond @scan_paths "Forbidden" 403

    # Reject obviously-malformed methods (TRACE, CONNECT etc.) — Express handles
    # only GET/HEAD/POST/PUT/PATCH/DELETE/OPTIONS.
    @bad_method not method GET HEAD POST PUT PATCH DELETE OPTIONS
    respond @bad_method "Method Not Allowed" 405

    # /metrics is api-internal; the api also gates this with METRICS_TOKEN, but
    # deny at the edge so probes never reach the backend.
    @metrics path /metrics /metrics/*
    respond @metrics "Forbidden" 403

    # ── API: forward /api/* to the api container ──────────────────────────────
    # SSE buffering disabled via flush_interval.
    handle /api/* {
        reverse_proxy api:5000 {
            flush_interval -1
            header_up Host              {host}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ── Static SPA — handled by the clinic (nginx) container ──────────────────
    # 8080: clinic runs nginx-unprivileged (non-root, cannot bind <1024).
    handle {
        reverse_proxy clinic:8080 {
            header_up Host              {host}
            header_up X-Real-IP         {remote_host}
            header_up X-Forwarded-For   {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Structured access log → docker logs (json-file driver in compose)
    log {
        output stdout
        format json
        level  INFO
    }
}
