# ── Stage 1: build the React SPA ──────────────────────────────────────────────
# Base images pinned by digest (F-08) for reproducible builds — bump via Renovate.
FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS build
RUN corepack enable
WORKDIR /app

# Copy workspace manifests (layer-cached until they change)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY artifacts/clinic/package.json     ./artifacts/clinic/
RUN pnpm install --frozen-lockfile --ignore-scripts --node-linker=hoisted

# Copy source (api-client-react is imported by clinic)
COPY lib/api-client-react/ ./lib/api-client-react/
COPY artifacts/clinic/     ./artifacts/clinic/

# Vite build — outputs to artifacts/clinic/dist/public/
RUN pnpm --filter @workspace/clinic run build

# ── Stage 2: serve static assets via nginx ────────────────────────────────────
# Unprivileged variant (Trivy DS-0002): runs as UID 101 (nginx), master process
# included — no root anywhere. Listens on 8080 (>1024, no NET_BIND_SERVICE);
# nginx.conf and the compose port/proxy references must say 8080 too.
FROM nginxinc/nginx-unprivileged:1.27-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0 AS runtime

# Copy built SPA into nginx's default root
COPY --from=build /app/artifacts/clinic/dist/public /usr/share/nginx/html

# Copy site config (SPA fallback + /api proxy to backend)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
