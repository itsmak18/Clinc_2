# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log

# Playwright (AUD-FE-01) — no leading slash: artifacts/clinic/playwright-report/
# is nested, not at repo root, so this must match at any depth to be effective.
playwright-report/
test-results/
blob-report/
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Environment — never commit real credentials
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.rehearsal

# Plaintext credential backups — must never be committed
credentials-backup.md
*credentials*.md
*credentials*.txt
*secrets*.md
*secrets*.txt
*backup*.env

# Database backup dumps — contain PHI, must never be committed
backups/
*.sql.gz

# Uploaded imaging files (X-ray / ultrasound) — local dev store (IMAGING_STORAGE_DIR
# default ./storage/imaging). Encrypted at rest, but still PHI; never commit.
storage/
